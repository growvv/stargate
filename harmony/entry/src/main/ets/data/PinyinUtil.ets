const LETTERS: string[] = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

export class PinyinUtil {
  /** 返回 A–Z 或 '#' 杂项桶。 */
  static initial(label: string): string {
    if (!label) return '#';
    const c = label.trim().charAt(0);
    if (!c) return '#';
    const code = c.charCodeAt(0);
    if (code >= 65 && code <= 90) return c;
    if (code >= 97 && code <= 122) return c.toUpperCase();
    const mapped = INITIALS[c];
    return mapped !== undefined ? mapped : '#';
  }

  /** 按 A–Z + '#' 分桶，键已排序，桶内按 label 排序。 */
  static group(items: AtomicFunction[]): Map<string, AtomicFunction[]> {
    const out = new Map<string, AtomicFunction[]>();
    if (!items || items.length === 0) return out;
    const buckets: Record<string, AtomicFunction[]> = {};
    for (const it of items) {
      const k = PinyinUtil.initial(it.label);
      if (!buckets[k]) buckets[k] = [];
      buckets[k].push(it);
    }
    const keys = LETTERS.concat(['#']);
    for (const k of keys) {
      if (buckets[k] && buckets[k].length > 0) {
        buckets[k].sort((a, b) => a.label.localeCompare(b.label));
        out.set(k, buckets[k]);
      }
    }
    return out;
  }
}

export default PinyinUtil;
